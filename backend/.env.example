# 数据库（与 docker-compose.yml 中 postgres 服务一致）
DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5433/agent_platform

# 产物存储根目录（StorageService 本地磁盘实现）
STORAGE_ROOT=./data/artifacts

# GLM（OpenAI 兼容协议）
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-plus

# 前端跨域（Vite dev）
ALLOWED_ORIGINS=http://localhost:5173
