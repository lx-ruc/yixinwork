# 数据库（本地裸跑指向宿主 5433；容器内由 compose 覆盖为 postgres:5432）
DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5433/agent_platform

# 产物存储根目录（StorageService 本地磁盘实现）
STORAGE_ROOT=./data/artifacts

# GLM（OpenAI 兼容协议）
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.3

# 前端跨域（Vite dev / 部署域名，逗号分隔）
ALLOWED_ORIGINS=http://localhost:5180

# 产物签名下载密钥（生产必须换：openssl rand -hex 32）
DOWNLOAD_SIGNING_SECRET=dev-insecure-download-secret

# 身份上下文：生产置 true，缺失 X-User-Id 直接 401；开发态回退默认用户
REQUIRE_USER_HEADER=false
DEV_DEFAULT_USER_ID=dev-local-user

# 内部运维接口（用量汇总）令牌；留空 = 接口关闭（403）
INTERNAL_API_TOKEN=

# API 限流（按用户，缺身份头回退 IP）；0 = 关闭
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# 代码沙箱
SANDBOX_IMAGE=yixin-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=60
